<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="公众号讲座提醒助手"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="运行状态：检测中..."
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btnOpenPermission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1. 开启通知监听权限" />

            <Button
                android:id="@+id/btnTestAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="2. 测试弹窗提醒" />
        </LinearLayout>

        <!-- 公众号管理卡片 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="监控的微信公众号"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etNewAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入公众号名称（如：某某大学）"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnAddAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加公众号" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- 关键词管理卡片 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="文章标题触发关键词（满足任一即弹窗）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etNewKeyword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入关键词（如：讲座、学术报告）"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnAddKeyword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加关键词" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- 历史记录卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="命中的讲座推文记录"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <Button
                android:id="@+id/btnPollNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="立即巡检" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="清空" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHistoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginTop="8dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
